{
  "name": "dsh-session-cloudsync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 会话云同步：自部署服务端、端到端加密，同步会话、附件、设备台账与 agent 笔记。",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"packages/**/tests/**/*.test.ts\" \"packages/**/tests/**/*.test.mjs\" \"packages/**/tests/**/*.integration.mjs\" \"tests/**/*.test.mjs\"",
    "test:shared": "node --test \"packages/shared/tests/**/*.test.ts\"",
    "test:server": "node --test \"packages/shared/tests/**/*.test.ts\" \"packages/server/tests/**/*.test.mjs\"",
    "test:plugin": "node --test \"packages/shared/tests/**/*.test.ts\" \"packages/plugin/tests/*.test.mjs\"",
    "test:integration": "node --test \"packages/plugin/tests/*.integration.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:plugin": "tsc -p tsconfig.plugin.json --noEmit",
    "check": "pnpm run typecheck && pnpm test",
    "check:server": "pnpm run typecheck:server && pnpm run test:server",
    "check:plugin": "pnpm run typecheck:plugin && pnpm run test:plugin",
    "fixtures": "node tests/tools/make-fixtures.ts",
    "bench:trace": "node tests/tools/session-trace.ts",
    "bench:generate": "node tests/tools/make-bench-session.ts",
    "bench:sync": "node tests/tools/bench-sync.ts",
    "dev:server": "node packages/server/src/index.ts serve --data-dir .tmp/dev-data --port 8787 --host 127.0.0.1",
    "dev:dsh": "node scripts/dev-dsh.mjs",
    "dev:console": "node tests/m0/console/server.mjs",
    "dev:panel": "node dev/console/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
